# Base URL of the asset CDN (no trailing slash).
#
# DEFAULT: GitHub + jsDelivr. No card, no billing account, nothing that can
# charge you. Create a PUBLIC repo for assets, push files to it, and point this
# at it. Format:
#
#   https://cdn.jsdelivr.net/gh/<github-user>/<assets-repo>@<branch-or-tag>
#
# Example:
#   NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.jsdelivr.net/gh/majinhutt/portfolio-assets@main
#
# Leave it unset and the site renders empty plates plus the procedural
# placeholder model instead of broken images: safe to deploy before any
# assets exist.
#
# See docs/ASSET-HOSTING.md before switching to Cloudflare R2: R2 requires a
# payment method on file, jsDelivr does not.
NEXT_PUBLIC_ASSET_BASE_URL=

# ── Email alerts (optional) ────────────────────────────────────────────────
# Sends James an email when someone downloads the CV or clicks a contact link.
# Free, no card. Get a key at https://web3forms.com by entering the address the
# alerts should go to (jpfhutt@gmail.com), which arrives by email in seconds.
#
# Leave this blank and the site makes no request at all: no key, no alerts,
# no third-party traffic.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Include a coarse location (city and ISP) in each alert.
#
# Off by default and worth leaving off. It sends the visitor's IP to a
# third-party lookup to get back a city that is usually the ISP's routing
# location rather than the person's, and is fiction behind a VPN. The referrer
# in each alert is a far better clue than the location ever will be.
NEXT_PUBLIC_ENABLE_GEO=false
