{"data":[{"id":22693212,"slug":"red-velvet-dining-chair","user_id":14054932,"title":"Red Velvet Dining Chair","description":"Hi everyone!\n\nHere is my third original 3D piece as an aspiring 3D modeller. I wanted to make something more realistic, so I used a chair from my dining room as reference and tried to recreate it, really focusing on improving my use of materials and lighting.\n\nMade in Blender.\n\nIf you have any tips or feedback to share, I’d greatly appreciate it!\n","created_at":"2026-08-03T04:48:42.163-05:00","updated_at":"2026-08-03T04:48:42.205-05:00","published_at":"2026-08-03T04:48:42.104-05:00","likes_count":1,"adult_content":false,"admin_adult_content":false,"cover_asset_id":101292820,"tag_list":null,"hash_id":"dL8Pm1","permalink":"https://www.artstation.com/artwork/dL8Pm1","hide_as_adult":false,"cover":{"id":101292820,"small_square_url":"https://cdna.artstation.com/p/assets/images/images/101/292/820/small_square/james-hutt-chair-3.jpg?1785749895","micro_square_image_url":"https://cdna.artstation.com/p/assets/images/images/101/292/820/micro_square/james-hutt-chair-3.jpg?1785749895","thumb_url":"https://cdna.artstation.com/p/assets/images/images/101/292/820/smaller_square/james-hutt-chair-3.jpg?1785749895"},"icons":{"image":true,"video":false,"video_clip":false,"model3d":false,"marmoset":false,"pano":false},"assets_count":3},{"id":22645561,"slug":"small-low-polly-island","user_id":14054932,"title":"Small Low Polly Island ","description":"Hi everyone!\n\nHere is my second original 3D piece as an aspiring 3D modeller. I really love the low poly art style, so I made a small island out at sea with a rowboat, and a bit of mystery... why is the rowboat there, and where is the person who sailed it?\n\nMade in Blender.\n\nIf you have any tips or feedback to share, I’d greatly appreciate it!","created_at":"2026-07-22T13:22:12.756-05:00","updated_at":"2026-07-22T13:22:12.767-05:00","published_at":"2026-07-22T13:22:12.745-05:00","likes_count":2,"adult_content":false,"admin_adult_content":false,"cover_asset_id":100998966,"tag_list":null,"hash_id":"5e8JBJ","permalink":"https://www.artstation.com/artwork/5e8JBJ","hide_as_adult":false,"cover":{"id":100998966,"small_square_url":"https://cdna.artstation.com/p/assets/images/images/100/998/966/small_square/james-hutt-ocean-island.jpg?1784743820","micro_square_image_url":"https://cdna.artstation.com/p/assets/images/images/100/998/966/micro_square/james-hutt-ocean-island.jpg?1784743820","thumb_url":"https://cdna.artstation.com/p/assets/images/images/100/998/966/smaller_square/james-hutt-ocean-island.jpg?1784743820"},"icons":{"image":true,"video":false,"video_clip":false,"model3d":false,"marmoset":false,"pano":false},"assets_count":2},{"id":22590235,"slug":"lego-batman-69","user_id":14054932,"title":"Lego Batman","description":"Hi everyone! \n\nThis is my first original 3D model as an aspiring 3D modeller. I am a big fan of the LEGO games, so I wanted to create a LEGO Batman model as my first original piece.\n\nMade in Blender.\n\nIf you have any Tips or knowlegde to impart it would be greatly appreciated.","created_at":"2026-07-09T08:27:30.028-05:00","updated_at":"2026-08-22T07:55:08.748-05:00","published_at":"2026-07-09T08:27:30.013-05:00","likes_count":0,"adult_content":false,"admin_adult_content":false,"cover_asset_id":100653549,"tag_list":null,"hash_id":"kw4GXK","permalink":"https://www.artstation.com/artwork/kw4GXK","hide_as_adult":false,"cover":{"id":100653549,"small_square_url":"https://cdnb.artstation.com/p/assets/images/images/100/653/549/20260709080425/small_square/james-hutt-lego-batman.jpg?1783602265","micro_square_image_url":"https://cdnb.artstation.com/p/assets/images/images/100/653/549/20260709080425/micro_square/james-hutt-lego-batman.jpg?1783602265","thumb_url":"https://cdnb.artstation.com/p/assets/images/images/100/653/549/20260709080425/smaller_square/james-hutt-lego-batman.jpg?1783602265"},"icons":{"image":false,"video":false,"video_clip":false,"model3d":false,"marmoset":false,"pano":true},"assets_count":2}],"total_count":3}